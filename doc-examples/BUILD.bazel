load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//third_party/java:rules.bzl", "java_library")
load("//tools/browser:rules.bzl", "browser_application")
load("//tools/release:release.bzl", "release_source_jar")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "java",
    srcs = [
        "//doc-examples/src/main/java/react4j/examples/arez:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/best_practice/step1:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/best_practice/step2:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/step1:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/step1/model:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/step2:sources",
        "//doc-examples/src/main/java/react4j/examples/arez/step2/model:sources",
        "//doc-examples/src/main/java/react4j/examples/factory_example:sources",
        "//doc-examples/src/main/java/react4j/examples/hello_world:sources",
    ],
    plugins = [
        "//:react4j_processor_plugin",
        "@arez//:arez_processor_plugin",
    ],
    deps = [
        "//:core",
        "//:dom",
    ],
)

release_source_jar(
    name = "sources",
    out = "examples-sources.jar",
    java_targets = [":java"],
)

j2cl_library(
    name = "j2cl",
    srcs = [":sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        "//:core-j2cl",
        "//:dom-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
        "@arez//:core-j2cl",
    ],
)

closure_js_library(
    name = "hello_world_entry",
    srcs = ["//doc-examples/src/main/java/react4j/examples/hello_world:HelloWorld.entry.js"],
    deps = [":j2cl"],
)

browser_application(
    name = "hello_world",
    entry_point = "react4j.examples.HelloWorldEntry",
    html = "//doc-examples/src/main/java/react4j/examples/hello_world:public/index.html",
    deps = [":hello_world_entry"],
)
