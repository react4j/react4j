load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//css:defs.bzl", "css_bundle")
load("//third_party/java:rules.bzl", "java_testng")
load("//tools/browser:java.bzl", "java_j2cl_library")

package(default_visibility = ["//visibility:public"])

java_j2cl_library(
    name = "fixture_dependency",
    testonly = True,
    srcs = [
        "PropertyTheme.java",
        "SharedDefaults.java",
        "SharedLabel.java",
        "SharedPulse.java",
        "StyleState.java",
        "UnselectedDefaults.java",
        "package-info.java",
    ],
    java_deps = ["//css/core"],
    plugins = ["//css/processor:plugin"],
    deps = [
        "//css/core:core-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "fixture_bindings",
    testonly = True,
    srcs = [
        "ButtonStyles.java",
        "SymbolStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_dependency_java",
        "//css/core",
    ],
    plugins = ["//css/processor:plugin"],
    deps = [
        ":fixture_dependency",
        "//css/core:core-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "peer_bindings",
    testonly = True,
    srcs = [
        "PeerStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_dependency_java",
        "//css/core",
    ],
    plugins = ["//css/processor:plugin"],
    deps = [
        ":fixture_dependency",
        "//css/core:core-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)

closure_js_library(
    name = "left",
    testonly = True,
    exports = [
        ":fixture_bindings",
        ":peer_bindings",
    ],
)

closure_js_library(
    name = "right",
    testonly = True,
    exports = [":fixture_bindings"],
)

closure_js_library(
    name = "graph",
    testonly = True,
    exports = [
        ":left",
        ":right",
    ],
)

css_bundle(
    name = "fixture_styles",
    testonly = True,
    css = "fixture.css",
    root = ":graph",
    source_map = "fixture.css.map",
)

css_bundle(
    name = "selected_styles",
    testonly = True,
    css = "selected.css",
    globals = ["react4j.css.integration.UnselectedDefaults"],
    root = ":graph",
    source_map = "selected.css.map",
)

java_testng(
    name = "integration_tests",
    srcs = [
        "CssIntegrationTest.java",
        "package-info.java",
    ],
    data = [
        "ButtonStyles.java",
        "PropertyTheme.java",
        "SharedDefaults.java",
        "SharedPulse.java",
        "SymbolStyles.java",
        ":fixture.css",
        ":fixture.css.map",
        ":fixture_bindings.js",
        ":selected.css",
        ":selected.css.map",
    ],
    jvm_flags = [
        "-Dcss.fixture=$(rootpath :fixture.css)",
        "-Dcss.map=$(rootpath :fixture.css.map)",
        "-Dcss.tree=$(rootpath :fixture_bindings.js)",
        "-Dcss.source=$(rootpath ButtonStyles.java)",
        "-Dcss.symbols_source=$(rootpath SymbolStyles.java)",
        "-Dcss.frames_source=$(rootpath SharedPulse.java)",
        "-Dcss.globals_source=$(rootpath SharedDefaults.java)",
        "-Dcss.selected=$(rootpath :selected.css)",
    ],
    test_class = "react4j.css.integration.CssIntegrationTest",
    deps = [
        ":fixture_bindings_java",
        ":fixture_dependency_java",
        "//third_party/java:ph_css",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_javascript_closure_compiler_unshaded",
    ],
)
