load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//css:defs.bzl", "css_bundle", "css_sources")
load("//third_party/java:rules.bzl", "java_testng")
load("//tools/browser:java.bzl", "java_j2cl_library")
load(":headers.bzl", "headers")
load(":validations.bzl", "validation_test")

package(default_visibility = [
    "//:__pkg__",
    "//css:__pkg__",
    "//css/integration-tests/src/test/js/react4j/css/integration:__pkg__",
])

java_j2cl_library(
    name = "fixture_contracts",
    testonly = True,
    srcs = [
        "StyleContracts.java",
        "StyleState.java",
        "package-info.java",
    ],
    java_deps = ["//css/core"],
    plugins = ["//:css_processor"],
    deps = [
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "fixture_dependency",
    testonly = True,
    srcs = [
        "PropertyTheme.java",
        "SharedDefaults.java",
        "SharedLabel.java",
        "SharedPulse.java",
        "UnselectedDefaults.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_contracts_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":fixture_contracts",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "fixture_bindings",
    testonly = True,
    srcs = [
        "ButtonStyles.java",
        "SymbolStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_contracts_java",
        ":fixture_dependency_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":fixture_contracts",
        ":fixture_dependency",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "peer_bindings",
    testonly = True,
    srcs = [
        "PeerStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_dependency_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":fixture_dependency",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

closure_js_library(
    name = "left",
    testonly = True,
    exports = [
        ":fixture_bindings",
        ":peer_bindings",
    ],
)

closure_js_library(
    name = "right",
    testonly = True,
    exports = [":fixture_bindings"],
)

closure_js_library(
    name = "graph",
    testonly = True,
    exports = [
        ":left",
        ":right",
    ],
)

css_bundle(
    name = "fixture_styles",
    testonly = True,
    css = "fixture.css",
    root = ":graph",
    source_map = "fixture.css.map",
)

css_bundle(
    name = "selected_styles",
    testonly = True,
    css = "selected.css",
    globals = ["react4j.css.integration.UnselectedDefaults"],
    root = ":graph",
    source_map = "selected.css.map",
)

java_testng(
    name = "integration_tests",
    srcs = [
        "CssInputIntegrationTest.java",
        "CssIntegrationTest.java",
        "CssLivenessIntegrationTest.java",
        "package-info.java",
    ],
    data = [
        "ButtonStyles.java",
        "LivenessEntry.java",
        "PropertyTheme.java",
        "SharedDefaults.java",
        "SharedPulse.java",
        "SymbolStyles.java",
        "defaults.css",
        "native.utilities.css",
        "utilities.css",
        ":fixture.css",
        ":fixture.css.map",
        ":fixture_bindings.js",
        ":liveness_entry.js",
        ":selected.css",
        ":selected.css.map",
        ":utility_dependency.js",
        ":utility_headers",
        ":utility_inputs_java",
        "//css/integration-tests/src/test/js/react4j/css/integration:alias.css",
        "//css/integration-tests/src/test/js/react4j/css/integration:development.css",
        "//css/integration-tests/src/test/js/react4j/css/integration:optimized.css",
        "//css/integration-tests/src/test/js/react4j/css/integration:optimized.css.map",
        "//css/integration-tests/src/test/js/react4j/css/integration:optimized.css-live.json",
        "//css/integration-tests/src/test/js/react4j/css/integration:optimized.js",
        "//css/integration-tests/src/test/js/react4j/css/integration:optimized.js.map",
        "//css/processor:processor_jar",
    ],
    jvm_flags = [
        "-Dcss.input.headers=$(rootpath :utility_headers)",
        "-Dcss.input.jar=$(rootpath :utility_inputs_java)",
        "-Dcss.input.tree=$(rootpath :utility_dependency.js)",
        "-Dcss.input.source=$(rootpath utilities.css)",
        "-Dcss.input.processor=$(rootpath //css/processor:processor_jar)",
        "-Dcss.liveness.binding_tree=$(rootpath :liveness_entry.js)",
        "-Dcss.liveness.source=$(rootpath LivenessEntry.java)",
        "-Dcss.liveness.development=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:development.css)",
        "-Dcss.liveness.alias=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:alias.css)",
        "-Dcss.liveness.optimized=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:optimized.css)",
        "-Dcss.liveness.map=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:optimized.css.map)",
        "-Dcss.liveness.javascript_map=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:optimized.js.map)",
        "-Dcss.liveness.javascript=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:optimized.js)",
        "-Dcss.liveness.names=$(rootpath //css/integration-tests/src/test/js/react4j/css/integration:optimized.css-live.json)",
        "-Dcss.fixture=$(rootpath :fixture.css)",
        "-Dcss.map=$(rootpath :fixture.css.map)",
        "-Dcss.tree=$(rootpath :fixture_bindings.js)",
        "-Dcss.source=$(rootpath ButtonStyles.java)",
        "-Dcss.symbols_source=$(rootpath SymbolStyles.java)",
        "-Dcss.frames_source=$(rootpath SharedPulse.java)",
        "-Dcss.globals_source=$(rootpath SharedDefaults.java)",
        "-Dcss.selected=$(rootpath :selected.css)",
    ],
    test_classes = [
        "react4j.css.integration.CssIntegrationTest",
        "react4j.css.integration.CssLivenessIntegrationTest",
        "react4j.css.integration.CssInputIntegrationTest",
    ],
    deps = [
        ":fixture_bindings_java",
        ":fixture_contracts_java",
        ":fixture_dependency_java",
        "//third_party:closure_compiler_unshaded",
        "//third_party:gson",
        "//third_party:ph_css",
    ],
)

css_sources(
    name = "utility_inputs",
    testonly = True,
    srcs = [
        "defaults.css",
        "native.utilities.css",
        "utilities.css",
    ],
)

java_j2cl_library(
    name = "utility_dependency",
    testonly = True,
    srcs = [
        "FileDefaults.java",
        "NativeUtilityLibrary.java",
        "UtilityLibrary.java",
        "package-info.java",
    ],
    java_deps = [
        ":fixture_dependency_java",
        ":utility_inputs_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":fixture_dependency",
        ":utility_inputs",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

headers(
    name = "utility_headers",
    testonly = True,
    dep = ":utility_dependency_java",
)

java_j2cl_library(
    name = "native_bindings",
    testonly = True,
    srcs = [
        "NativeStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":utility_dependency_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":utility_dependency",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "other_native_bindings",
    testonly = True,
    srcs = [
        "OtherNativeStyles.java",
        "package-info.java",
    ],
    java_deps = [
        ":utility_dependency_java",
        "//css/core",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":utility_dependency",
        "//:css",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "liveness_entry",
    testonly = True,
    srcs = [
        "LivenessEntry.java",
        "package-info.java",
    ],
    java_deps = [
        ":native_bindings_java",
        ":other_native_bindings_java",
        ":utility_dependency_java",
        ":fixture_bindings_java",
        ":fixture_contracts_java",
        "//css/core",
        "//third_party/java:jsinterop_annotations",
    ],
    plugins = ["//:css_processor"],
    deps = [
        ":fixture_bindings",
        ":fixture_contracts",
        ":native_bindings",
        ":other_native_bindings",
        ":utility_dependency",
        "//:css",
        "//third_party:jsinterop_annotations-j2cl",
        "//third_party:jspecify-j2cl",
    ],
)

java_j2cl_library(
    name = "asset_bindings",
    testonly = True,
    srcs = [
        "AssetFixtures.java",
        "CssAssetStyles.java",
        "package-info.java",
    ],
    java_deps = [
        "//css/core",
        "//third_party/java:jsinterop_annotations",
    ],
    plugins = ["//:css_processor"],
    deps = [
        "//:css",
        "//css/integration-tests/src/test/assets/react4j/css/integration:media",
        "//third_party:jsinterop_annotations-j2cl",
        "//third_party:jspecify-j2cl",
    ],
)

java_testng(
    name = "asset_tests",
    srcs = [
        "AssetIntegrationTest.java",
        "package-info.java",
    ],
    data = [
        ":asset.css",
        ":asset_bindings.js",
        "//css/integration-tests/src/test/assets/react4j/css/integration:media.assets.json",
    ],
    jvm_flags = [
        "-Dassets.tree=$(rootpath :asset_bindings.js)",
        "-Dassets.catalogue=$(rootpath //css/integration-tests/src/test/assets/react4j/css/integration:media.assets.json)",
    ],
    test_class = "react4j.css.integration.AssetIntegrationTest",
    deps = ["//css/internal/src/main/java/react4j/css/internal"],
)

css_bundle(
    name = "asset_styles",
    testonly = True,
    css = "asset.css",
    root = ":asset_bindings",
    source_map = "asset.css.map",
)

filegroup(
    name = "asset_test_tree",
    testonly = True,
    srcs = [":asset_bindings.js"],
    visibility = ["//css/bundler/src/test/java/react4j/css/bundler:__pkg__"],
)

validation_test(
    name = "library_validations_test",
    libraries = [
        ":fixture_contracts",
        ":fixture_dependency",
        ":fixture_bindings",
        ":peer_bindings",
    ],
    root = ":fixture_styles",
)

validation_test(
    name = "linked_validations_test",
    libraries = [
        ":fixture_contracts",
        ":fixture_dependency",
        ":fixture_bindings",
        ":utility_dependency",
        ":liveness_entry",
    ],
    root = "//css/integration-tests/src/test/js/react4j/css/integration:optimized_styles",
)

validation_test(
    name = "web_validations_test",
    libraries = [":asset_bindings"],
    root = "//css/integration-tests/src/test/js/react4j/css/integration:asset_optimized_web",
)

test_suite(
    name = "validation_tests",
    tests = [
        ":library_validations_test",
        ":linked_validations_test",
        ":web_validations_test",
    ],
)
