load("//third_party/java:rules.bzl", "java_binary", "java_library")

java_library(
    name = "processor",
    srcs = [
        "AssetDeclarations.java",
        "CssAccessor.java",
        "CssCompiler.java",
        "CssDescriptor.java",
        "CssFonts.java",
        "CssGenerator.java",
        "CssIds.java",
        "CssInputJar.java",
        "CssMethods.java",
        "CssProcessor.java",
        "CssProperties.java",
        "CssSymbols.java",
        "Names.java",
        "TextBlock.java",
        "UtilitySelectors.java",
        "package-info.java",
    ],
    resource_strip_prefix = "css/processor/src/main/resources",
    resources = ["//css/processor/src/main/resources/META-INF/services:javax.annotation.processing.Processor"],
    visibility = [
        "//:__pkg__",
        "//css/processor:__pkg__",
        "//css/processor/src/test/java/react4j/css/processor:__pkg__",
    ],
    deps = [
        "//css/internal/src/main/java/react4j/css/internal",
        "//third_party:gson",
        "//third_party:ph_css",
        "//third_party:proton_core",
        "//third_party/java:javapoet",
    ],
)

java_binary(
    name = "css_inputs",
    main_class = "react4j.css.processor.CssInputJar",
    visibility = ["//css:__pkg__"],
    runtime_deps = [":processor"],
)
