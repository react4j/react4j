load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_binary")
load("//tools/release:release.bzl", "release_jar")

package(default_visibility = ["//visibility:public"])

release_jar(
    name = "processor_jar",
    out = "css-processor.jar",
    exclude_prefixes = [
        "org/jspecify/",
        "LICENSE",
        "NOTICE",
        "META-INF/LICENSE",
        "META-INF/NOTICE",
        "META-INF/DEPENDENCIES",
        "META-INF/versions/",
        "META-INF/buildinfo.xml",
        "META-INF/sbom/",
    ],
    relocations = [
        "com.helger=react4j.css.processor.vendor.helger",
        "org.slf4j=react4j.css.processor.vendor.slf4j",
    ],
    resource_entries = ["META-INF/LICENSE"],
    resource_files = ["//:LICENSE"],
    runtime_java_targets = ["//css/processor/src/main/java/react4j/css/processor"],
)

java_import(
    name = "processor",
    jars = [":processor_jar"],
)

# The adapter is included in the assembled jar so it can share package-private compiler code.
java_binary(
    name = "compiler",
    main_class = "react4j.css.processor.Compile",
    runtime_deps = [":processor"],
)
