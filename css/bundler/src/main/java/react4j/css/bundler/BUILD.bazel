load("//third_party/java:rules.bzl", "java_binary", "java_library")

java_library(
    name = "bundler",
    srcs = [
        "Bundle.java",
        "CssPruner.java",
        "CssReachability.java",
        "package-info.java",
    ],
    visibility = [
        "//:__pkg__",
        "//css:__subpackages__",
    ],
    deps = [
        "//css/internal/src/main/java/react4j/css/internal",
        "//third_party/java:ph_css",
        "@maven//:com_google_code_gson_gson",
    ],
)

java_binary(
    name = "tool",
    main_class = "react4j.css.bundler.Bundle",
    visibility = ["//css/bundler:__pkg__"],
    runtime_deps = [":bundler"],
)

java_library(
    name = "assets",
    srcs = [
        "AssetBundle.java",
        "AssetCss.java",
        "AssetJavaScript.java",
        "package-info.java",
    ],
    visibility = ["//css:__subpackages__"],
    deps = [
        "//css/internal/src/main/java/react4j/css/internal",
        "//css/linker/src/main/java/react4j/css/linker",
        "@maven//:com_google_code_gson_gson",
        "@rules_closure//closure/compiler",
    ],
)

java_binary(
    name = "assets_tool",
    main_class = "react4j.css.bundler.AssetBundle",
    visibility = ["//css:__pkg__"],
    runtime_deps = [":assets"],
)
