load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//third_party/java:rules.bzl", "java_binary", "java_library", "java_testng")
load(":rules.bzl", "styles")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "annotations",
    srcs = [
        "src/main/java/org/realityforge/css/Css.java",
        "src/main/java/org/realityforge/css/package-info.java",
    ],
)

j2cl_library(
    name = "annotations-j2cl",
    srcs = ["src/main/java/org/realityforge/css/Css.java"],
)

java_library(
    name = "processor",
    srcs = [
        "src/main/java/org/realityforge/css/CssCompiler.java",
        "src/main/java/org/realityforge/css/CssProcessor.java",
        "src/main/java/org/realityforge/css/Names.java",
        "src/main/java/org/realityforge/css/TextBlock.java",
        "src/main/java/org/realityforge/css/package-info.java",
    ],
    resource_strip_prefix = "css/src/main/resources",
    resources = ["src/main/resources/META-INF/services/javax.annotation.processing.Processor"],
    deps = [
        ":annotations",
        "//third_party/java:ph_css",
    ],
)

java_binary(
    name = "compiler",
    srcs = ["src/main/java/org/realityforge/css/Compile.java"],
    main_class = "org.realityforge.css.Compile",
    deps = [":processor"],
)

java_testng(
    name = "processor_tests",
    srcs = ["src/test/java/org/realityforge/css/CssProcessorTest.java"],
    test_class = "org.realityforge.css.CssProcessorTest",
    deps = [
        ":annotations",
        ":processor",
    ],
)

java_testng(
    name = "compiler_tests",
    srcs = ["src/test/java/org/realityforge/css/CssCompilerTest.java"],
    test_class = "org.realityforge.css.CssCompilerTest",
    deps = [":processor"],
)

java_library(
    name = "fixture_dependency",
    testonly = True,
    srcs = [
        "src/test/java/org/realityforge/css/integration/StyleState.java",
        "src/test/java/org/realityforge/css/integration/package-info.java",
    ],
)

styles(
    name = "fixture_styles",
    testonly = True,
    srcs = ["src/test/java/org/realityforge/css/integration/ButtonStyles.java"],
    deps = [":fixture_dependency"],
)

filegroup(
    name = "fixture_sources",
    testonly = True,
    srcs = [":fixture_styles"],
    output_group = "sources",
)

filegroup(
    name = "fixture_css",
    testonly = True,
    srcs = [":fixture_styles"],
    output_group = "css",
)

java_library(
    name = "fixture_bindings",
    testonly = True,
    srcs = [
        "src/test/java/org/realityforge/css/integration/ButtonStyles.java",
        "src/test/java/org/realityforge/css/integration/package-info.java",
        ":fixture_sources",
    ],
    deps = [
        ":annotations",
        ":fixture_dependency",
    ],
)

java_testng(
    name = "integration_tests",
    srcs = [
        "src/test/java/org/realityforge/css/integration/CssIntegrationTest.java",
        "src/test/java/org/realityforge/css/integration/package-info.java",
    ],
    data = [":fixture_css"],
    jvm_flags = ["-Dcss.fixture=$(rootpath :fixture_css)"],
    test_class = "org.realityforge.css.integration.CssIntegrationTest",
    deps = [
        ":fixture_bindings",
        ":fixture_dependency",
    ],
)
