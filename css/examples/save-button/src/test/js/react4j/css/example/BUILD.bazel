load("//css:defs.bzl", "css_bundle")
load("//tools/browser:rules.bzl", "browser_test")
load(":variants.bzl", "naming_variant")

package(default_visibility = ["//:__pkg__"])

browser_test(
    name = "browser_tests",
    srcs = ["browser_test.js"],
    data = [
        ":alternate_styles",
        ":component_styles",
        ":styles",
        "//css/examples/save-button:asset_example",
        "//css/examples/save-button:asset_example_manifest",
    ],
    entry_point = "react4j.css.example.BrowserTest",
    deps = [
        "//css/examples/save-button/src/main/java/react4j/css/example:browser",
        "@rules_closure//closure/testing/library:testcase",
    ],
)

css_bundle(
    name = "styles",
    testonly = True,
    css = "styles.css",
    globals = [
        "react4j.css.example.BrowserExample$Theme",
        "react4j.css.example.BrowserExample$Defaults",
    ],
    root = ":browser_tests_bin",
    shared = ["//css/examples/save-button/src/main/css:shared.css"],
    source_map = "styles.css.map",
)

css_bundle(
    name = "alternate_styles",
    testonly = True,
    css = "alternate.css",
    globals = [
        "react4j.css.example.BrowserExample$AlternateTheme",
        "react4j.css.example.BrowserExample$Defaults",
    ],
    root = ":browser_tests_bin",
    shared = ["//css/examples/save-button/src/main/css:shared.css"],
    source_map = "alternate.css.map",
)

css_bundle(
    name = "component_styles",
    testonly = True,
    css = "component.css",
    root = ":browser_tests_bin",
    source_map = "component.css.map",
)

naming_variant(
    name = "uncompressed",
    defs = ["--define=react4j.css.compress_names=false"],
)

naming_variant(
    name = "prefixed",
    defs = ["--define=react4j.css.name_prefix='app-'"],
)
