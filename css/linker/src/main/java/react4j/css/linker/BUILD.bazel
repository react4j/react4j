load("//third_party/java:rules.bzl", "java_binary", "java_library")

java_library(
    name = "linker",
    srcs = [
        "BindingSourceMap.java",
        "CssCompilerFactory.java",
        "StyleCompiler.java",
        "package-info.java",
    ],
    resource_strip_prefix = "css/linker/src/main/resources",
    resources = ["//css/linker/src/main/resources/META-INF/services:com.google.javascript.jscomp.CompilerFactory"],
    visibility = [
        "//:__pkg__",
        "//css/bundler/src/main/java/react4j/css/bundler:__pkg__",
        "//css/linker/src/test/java/react4j/css/linker:__pkg__",
    ],
    deps = [
        "//css/internal/src/main/java/react4j/css/internal",
        "//third_party:closure_compiler",
        "//third_party:closure_compiler_factory",
        "//third_party:gson",
    ],
)

java_binary(
    name = "worker",
    jvm_flags = [
        "-Xmx2g",
        "-Xss20m",
        "-XX:+UseParallelGC",
    ],
    main_class = "io.bazel.rules.closure.ClosureWorker",
    visibility = ["//css:__pkg__"],
    runtime_deps = [
        ":linker",
        "//third_party:closure_worker_main",
    ],
)

java_binary(
    name = "catalogue",
    main_class = "react4j.css.internal.CssLink",
    visibility = ["//css:__pkg__"],
    runtime_deps = ["//css/internal/src/main/java/react4j/css/internal"],
)
