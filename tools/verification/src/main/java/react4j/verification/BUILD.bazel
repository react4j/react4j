load("//third_party/java:rules.bzl", "java_binary", "java_library")

java_library(
    name = "coverage",
    srcs = ["CoverageCheck.java"],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
    deps = ["//third_party:gson"],
)

java_binary(
    name = "coverage_check",
    main_class = "react4j.verification.CoverageCheck",
    visibility = [
        "//:__pkg__",
        "//tools/verification:__pkg__",
    ],
    runtime_deps = [":coverage"],
)

java_library(
    name = "browser_coverage",
    srcs = [
        "BrowserCoverage.java",
        "package-info.java",
    ],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
    deps = [
        "//third_party:gson",
        "//third_party:java_runfiles",
    ],
)

java_library(
    name = "coverage_instrumenter",
    srcs = ["CoverageInstrumenter.java"],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
    deps = ["//third_party:closure_compiler"],
)

java_library(
    name = "lcov_report",
    srcs = ["LcovReport.java"],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
)

java_library(
    name = "java_coverage",
    srcs = ["JavaCoverage.java"],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
    deps = [
        ":coverage_instrumenter",
        ":lcov_report",
    ],
)

java_library(
    name = "runtime_coverage_lib",
    srcs = [
        "JavaInventory.java",
        "RuntimeCoverage.java",
    ],
    visibility = [
        "//:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
    deps = [
        ":browser_coverage",
        ":coverage_instrumenter",
        ":java_coverage",
        ":lcov_report",
        "//third_party:closure_compiler",
        "//third_party:gson",
        "//third_party:java_coverage_runner",
        "//third_party:java_runfiles",
    ],
)

java_binary(
    name = "runtime_coverage",
    testonly = True,
    args = [
        "$(rootpath //tools/verification/src/test/js/react4j/verification:runtime.js)",
        "$(rootpath //tools/generation:react_dev)",
        "$(rootpath //tools/generation:react_dom_dev)",
        "$(rootpath //tools/webtesting:chromium.json)",
        "$(rootpath //tools/release:core_sources)",
        "$(rootpath //tools/release:dom_sources)",
        "$(rootpath //tools/verification:core_modules)",
        "$(rootpath //tools/verification:dom_modules)",
        "$(rootpath //tools/verification:runtime_sources)",
        "$(rootpath //tools/release:core_jar)",
        "$(rootpath //tools/release:dom_jar)",
    ],
    data = [
        "//tools/generation:react_dev",
        "//tools/generation:react_dom_dev",
        "//tools/release:core_jar",
        "//tools/release:core_sources",
        "//tools/release:dom_jar",
        "//tools/release:dom_sources",
        "//tools/verification:core_modules",
        "//tools/verification:dom_modules",
        "//tools/verification:runtime_sources",
        "//tools/verification/src/test/js/react4j/verification:runtime.js",
        "//tools/webtesting:chromium.json",
        "//tools/webtesting:chromium_files",
    ],
    jvm_flags = [
        "-Dreact4j.browser.binary='$(CHROME-HEADLESS-SHELL)'",
        "-Dreact4j.browser.driver='$(CHROMEDRIVER)'",
    ],
    main_class = "react4j.verification.RuntimeCoverage",
    toolchains = ["//tools/webtesting:chromium_files"],
    visibility = ["//tools/verification:__pkg__"],
    runtime_deps = [":runtime_coverage_lib"],
)
