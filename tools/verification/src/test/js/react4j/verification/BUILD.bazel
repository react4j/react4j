load("@rules_closure//closure:defs.bzl", "closure_js_binary", "closure_js_library")

package(default_visibility = [
    "//tools/verification/src/main/java/react4j/verification:__pkg__",
    "//tools/verification/src/test/java/react4j/verification:__pkg__",
])

closure_js_library(
    name = "fixture_lib",
    testonly = True,
    srcs = ["fixture_test.js"],
    deps = [
        "//tools/verification/src/test/java/react4j/verification/fixture",
    ],
)

closure_js_binary(
    name = "fixture",
    testonly = True,
    compilation_level = "BUNDLE",
    dependency_mode = "SORT_ONLY",
    deps = [":fixture_lib"],
)

closure_js_library(
    name = "runtime_lib",
    testonly = True,
    srcs = ["runtime_test.js"],
    deps = [
        "//:dom",
