        "//core/src/test/js/react4j:runtime_test",
        "//dom/src/test/js/react4j/dom:events_test",
        "//dom/src/test/js/react4j/dom:properties_test",
        "//dom/src/test/js/react4j/dom:runtime_test",
        "//tools/browser:mode",
    ],
)

closure_js_binary(
    name = "runtime",
    testonly = True,
    compilation_level = "BUNDLE",
    dependency_mode = "SORT_ONLY",
    deps = [":runtime_lib"],
