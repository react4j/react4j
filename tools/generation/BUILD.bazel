load(":generation.bzl", "dom_source", "react_asset")

package(default_visibility = ["//:__subpackages__"])

alias(
    name = "dom_generator",
    actual = "//tools/generation/src/main/java/react4j/generation:dom_generator",
)

alias(
    name = "react_asset_patcher",
    actual = "//tools/generation/src/main/java/react4j/generation:react_asset_patcher",
)

dom_source(
    name = "dom_sources",
    out = "dom.srcjar",
)

react_asset(
    name = "react_dev",
    src = "@react_development//file",
    out = "react4j/public/dev/react.js",
    mode = "development",
    visibility = [
        "//tools/browser:__pkg__",
        "//tools/release:__pkg__",
        "//tools/verification/src/main/java/react4j/verification:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
)

react_asset(
    name = "react_prod",
    src = "@react_production//file",
    out = "react4j/public/react.js",
    mode = "production",
    visibility = [
        "//tools/browser:__pkg__",
        "//tools/release:__pkg__",
    ],
)

react_asset(
    name = "react_dom_dev",
    src = "@react_dom_development//file",
    out = "react4j/dom/public/dev/react-dom.js",
    mode = "copy",
    visibility = [
        "//tools/browser:__pkg__",
        "//tools/release:__pkg__",
        "//tools/verification/src/main/java/react4j/verification:__pkg__",
        "//tools/verification/src/test/java/react4j/verification:__pkg__",
    ],
)

react_asset(
    name = "react_dom_prod",
    src = "@react_dom_production//file",
    out = "react4j/dom/public/react-dom.js",
    mode = "copy",
    visibility = [
        "//tools/browser:__pkg__",
        "//tools/release:__pkg__",
    ],
)

filegroup(
    name = "assets",
    srcs = [
        ":react_dev",
        ":react_dom_dev",
        ":react_dom_prod",
        ":react_prod",
    ],
)
