load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "audio_sources",
    srcs = [
        "AudioBuffer.java",
        "AudioBufferSourceNode.java",
        "AudioContext.java",
        "AudioNode.java",
        "AudioParam.java",
        "EventHandler.java",
        "GainNode.java",
        "package-info.java",
    ],
    visibility = ["//:__pkg__"],
)

j2cl_library(
    name = "audio",
    srcs = [":audio_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = ["@sting//third_party/java:nullaway_plugin"],
    deps = [
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/core",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/promise",
        "//examples/third_party/java:jspecify",
        "@j2cl//:jsinterop-annotations-j2cl",
    ],
)
