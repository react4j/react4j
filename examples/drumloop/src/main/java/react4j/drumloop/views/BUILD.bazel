load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

j2cl_library(
    name = "views",
    srcs = [
        "BpmInput.java",
        "DrumMachineView.java",
        "Fonts.java",
        "FxButton.java",
        "IndicatorView.java",
        "PlayButton.java",
        "StepButton.java",
        "TrackView.java",
        "ViewsFragment.java",
        "package-info.java",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@sting//third_party/java:nullaway_plugin",
        "@react4j//:css_processor",
        "@react4j//:processor",
        "@arez//:arez_processor_plugin",
        "@sting//:sting_processor_plugin",
    ],
    deps = [
        "//examples/drumloop/src/main/assets/react4j/drumloop/views:fonts",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/audio",
        "//examples/drumloop/src/main/java/react4j/drumloop/model",
        "//examples/third_party/java:jspecify",
        "//examples/third_party/java:sting",
        "@arez//:core-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@jsinterop_base//:jsinterop-base-j2cl",
        "@react4j//:core",
        "@react4j//:css",
        "@react4j//:dom",
    ],
)
