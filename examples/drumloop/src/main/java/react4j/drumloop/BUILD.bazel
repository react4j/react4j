load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "drumloop_sources",
    srcs = [
        "App.java",
        "package-info.java",
    ],
    visibility = ["//:__pkg__"],
)

j2cl_library(
    name = "drumloop",
    srcs = [":drumloop_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = ["@sting//third_party/java:nullaway_plugin"],
    deps = [
        "//examples/drumloop/src/main/java/react4j/drumloop/browser",
        "//examples/drumloop/src/main/java/react4j/drumloop/ioc",
        "//examples/drumloop/src/main/java/react4j/drumloop/views",
        "//examples/third_party/java:jspecify",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@react4j//:core",
        "@react4j//:dom",
    ],
)

exports_files(
    [
        "App.entry.js",
    ],
    visibility = ["//:__subpackages__"],
)
