load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

j2cl_library(
    name = "drumloop",
    srcs = [
        "App.java",
        "package-info.java",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = ["@react4j//third_party:nullaway_plugin"],
    deps = [
        "//examples/drumloop/src/main/java/react4j/drumloop/browser",
        "//examples/drumloop/src/main/java/react4j/drumloop/ioc",
        "//examples/drumloop/src/main/java/react4j/drumloop/views",
        "@react4j//:core",
        "@react4j//:dom",
        "@react4j//third_party:jsinterop_annotations-j2cl",
        "@react4j//third_party:jspecify-j2cl",
    ],
)

exports_files(
    [
        "App.entry.js",
    ],
    visibility = ["//:__subpackages__"],
)
