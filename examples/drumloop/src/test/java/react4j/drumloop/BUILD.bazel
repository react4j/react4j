load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = [
    "//:__pkg__",
    "//examples/drumloop/src/test/js/react4j/drumloop:__pkg__",
])

j2cl_library(
    name = "browser_tests",
    testonly = True,
    srcs = [
        "DrumloopBrowserTest.java",
        "DrumloopBrowserTest.native.js",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = ["@sting//third_party/java:nullaway_plugin"],
    deps = [
        "//examples/testing/src/main/java/react4j/webtesting:browser",
        "//examples/third_party/java:jspecify",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@jsinterop_base//:jsinterop-base-j2cl",
    ],
)
