load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//third_party/java:rules.bzl", "java_library")
load("//tools/browser:rules.bzl", "browser_application", "browser_application_variant", "browser_test")
load("//tools/release:release.bzl", "release_source_jar")

package(default_visibility = ["//visibility:public"])

exports_files(["landing.html"])

java_library(
    name = "java",
    srcs = [
        "//examples/drumloop/src/main/java/react4j/drumloop:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/audio:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/core:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/promise:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/ioc:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/model:sources",
        "//examples/drumloop/src/main/java/react4j/drumloop/views:sources",
    ],
    plugins = [
        "//:react4j_processor_plugin",
        "@arez//:arez_processor_plugin",
        "@sting//:sting_processor_plugin",
    ],
    deps = [
        "//:core",
        "//:dom",
        "//third_party/java:sting_core",
    ],
)

release_source_jar(
    name = "sources",
    out = "drumloop-sources.jar",
    java_targets = [":java"],
    resource_entries = ["react4j/drumloop/ReactCache.native.js"],
    resource_files = ["//examples/drumloop/src/main/java/react4j/drumloop:ReactCache.native.js"],
)

j2cl_library(
    name = "j2cl",
    srcs = [":sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        "//:core-j2cl",
        "//:dom-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
        "//third_party/java:sting_core-j2cl",
        "//third_party/java:zemeckis_core-j2cl",
        "@arez//:core-j2cl",
    ],
)

closure_js_library(
    name = "entry",
    srcs = ["//examples/drumloop/src/main/java/react4j/drumloop:App.entry.js"],
    deps = [":j2cl"],
)

browser_application(
    name = "drumloop",
    assets = {
        "public/css/styles.css": "css/styles.css",
        "public/fonts/OFL.txt": "fonts/OFL.txt",
        "public/fonts/Righteous-Regular.ttf": "fonts/Righteous-Regular.ttf",
        "public/sounds/bass.wav": "sounds/bass.wav",
        "public/sounds/clap.wav": "sounds/clap.wav",
        "public/sounds/hat2.wav": "sounds/hat2.wav",
        "public/sounds/hey.wav": "sounds/hey.wav",
        "public/sounds/kick.wav": "sounds/kick.wav",
        "public/sounds/loop.wav": "sounds/loop.wav",
        "public/sounds/loop130.wav": "sounds/loop130.wav",
        "public/sounds/openhihat.wav": "sounds/openhihat.wav",
        "public/sounds/snare.wav": "sounds/snare.wav",
        "public/sounds/sub.wav": "sounds/sub.wav",
        "public/sounds/yeah.wav": "sounds/yeah.wav",
    },
    entry_point = "react4j.drumloop.AppEntry",
    html = "public/index.html",
    deps = [":entry"],
)

browser_application_variant(
    name = "production",
    application = ":drumloop",
    mode = "opt",
)

browser_application_variant(
    name = "development",
    application = ":drumloop",
    mode = "fastbuild",
)

java_library(
    name = "test_java",
    testonly = True,
    srcs = ["//examples/drumloop/src/test/java/react4j/drumloop:ReactCacheTest.java"],
    deps = [
        ":java",
        "//third_party/java:base",
        "//third_party/java:jsinterop_annotations",
    ],
)

release_source_jar(
    name = "test_sources",
    testonly = True,
    out = "drumloop-test-sources.jar",
    java_targets = [":test_java"],
    resource_entries = ["react4j/drumloop/ReactCacheTest.native.js"],
    resource_files = ["//examples/drumloop/src/test/java/react4j/drumloop:ReactCacheTest.native.js"],
)

j2cl_library(
    name = "test_j2cl",
    testonly = True,
    srcs = [":test_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        ":j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)

browser_test(
    name = "browser_tests",
    srcs = ["browser_test.js"],
    data = [":drumloop"],
    entry_point = "react4j.drumloop.BrowserTest",
    deps = [
        ":test_j2cl",
        "@rules_closure//closure/testing/library:testcase",
    ],
)
