load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//tools/browser:rules.bzl", "browser_application", "browser_application_variant")

package(default_visibility = ["//visibility:public"])

closure_js_library(
    name = "entry",
    srcs = ["//examples/heart-rate-monitor/src/main/java/react4j/hrm:Main.entry.js"],
    deps = ["//examples/heart-rate-monitor/src/main/java/react4j/hrm"],
)

browser_application(
    name = "heart-rate-monitor",
    assets = {
        "public/css/index.css": "css/index.css",
        "public/img/heart.svg": "img/heart.svg",
    },
    entry_point = "react4j.hrm.MainEntry",
    html = "public/index.html",
    deps = [":entry"],
)

browser_application_variant(
    name = "production",
    application = ":heart-rate-monitor",
    mode = "opt",
)

browser_application_variant(
    name = "development",
    application = ":heart-rate-monitor",
    mode = "fastbuild",
)
