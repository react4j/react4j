load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = [
    "//:__pkg__",
    "//examples/todomvc:__subpackages__",
])

j2cl_library(
    name = "views",
    srcs = [
        "Page.java",
        "package-info.java",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@sting//third_party/java:nullaway_plugin",
        "@react4j//:processor",
        "@react4j//:css_processor",
        "@arez//:arez_processor_plugin",
    ],
    deps = [
        "//examples/third_party/java:jspecify",
        "@arez//:core-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@jsinterop_base//:jsinterop-base-j2cl",
        "@react4j//:core",
        "@react4j//:css",
        "@react4j//:dom",
    ],
)

j2cl_library(
    name = "assets",
    srcs = ["ItemAssets.java"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@sting//third_party/java:nullaway_plugin",
        "@react4j//:css_processor",
    ],
    deps = [
        "//examples/third_party/java:jspecify",
        "//examples/todomvc/src/main/assets/react4j/todomvc/views:toggles",
        "@react4j//:css",
    ],
)
