load("@react4j//:defs.bzl", "browser_application", "browser_application_variant", "css_bundle")
load("@rules_closure//closure:defs.bzl", "closure_js_library")

package(default_visibility = ["//:__subpackages__"])

closure_js_library(
    name = "entry",
    srcs = ["//examples/todomvc/raw/src/main/java/react4j/todomvc/raw:App.entry.js"],
    deps = ["//examples/todomvc/raw/src/main/java/react4j/todomvc/raw:todomvc"],
)

css_bundle(
    name = "styles",
    css = "index.css",
    root = ":raw_bundle",
    source_map = "index.css.map",
)

browser_application(
    name = "raw",
    entry_point = "react4j.todomvc.raw.AppEntry",
    html = "//examples/todomvc:public/index.html",
    styles = {":styles": "css/index.css"},
    deps = [":entry"],
)

browser_application_variant(
    name = "development",
    application = ":raw",
    mode = "fastbuild",
)

browser_application_variant(
    name = "production",
    application = ":raw",
    mode = "opt",
)
