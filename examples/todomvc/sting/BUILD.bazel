load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//tools/browser:rules.bzl", "browser_application", "browser_application_variant")

package(default_visibility = ["//visibility:public"])

closure_js_library(
    name = "entry",
    srcs = ["//examples/todomvc/sting/src/main/java/react4j/todomvc/sting:App.entry.js"],
    deps = ["//examples/todomvc/sting/src/main/java/react4j/todomvc/sting:todomvc"],
)

browser_application(
    name = "sting",
    assets = {
        "//examples/todomvc:public/css/base.css": "css/base.css",
        "//examples/todomvc:public/css/index.css": "css/index.css",
        "//examples/todomvc:public/css/toggle.svg": "css/toggle.svg",
        "//examples/todomvc:public/css/toggle_checked.svg": "css/toggle_checked.svg",
    },
    entry_point = "react4j.todomvc.sting.AppEntry",
    html = "//examples/todomvc:public/index.html",
    deps = [":entry"],
)

browser_application_variant(
    name = "development",
    application = ":sting",
    mode = "fastbuild",
)

browser_application_variant(
    name = "production",
    application = ":sting",
    mode = "opt",
)
