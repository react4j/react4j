load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//css:rules.bzl", "css_bundle")
load("//tools/browser:rules.bzl", "browser_application", "browser_application_variant")

package(default_visibility = ["//visibility:public"])

closure_js_library(
    name = "entry",
    srcs = ["//examples/todomvc/sting/src/main/java/react4j/todomvc/sting:App.entry.js"],
    deps = ["//examples/todomvc/sting/src/main/java/react4j/todomvc/sting:todomvc"],
)

css_bundle(
    name = "styles",
    css = "index.css",
    root = ":sting_bundle",
    shared = [
        "//examples/todomvc/src/main/css:base.css",
        "//examples/todomvc/src/main/css:shared.css",
    ],
    source_map = "index.css.map",
)

browser_application(
    name = "sting",
    assets = {
        "//examples/todomvc/src/main/assets/css:toggle.svg": "css/toggle.svg",
        "//examples/todomvc/src/main/assets/css:toggle_checked.svg": "css/toggle_checked.svg",
        ":index.css": "css/index.css",
        ":index.css.map": "css/index.css.map",
    },
    entry_point = "react4j.todomvc.sting.AppEntry",
    html = "//examples/todomvc:public/index.html",
    deps = [":entry"],
)

browser_application_variant(
    name = "development",
    application = ":sting",
    mode = "fastbuild",
)

browser_application_variant(
    name = "production",
    application = ":sting",
    mode = "opt",
)
