load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "views_sources",
    srcs = [
        "Footer.java",
        "FooterTodoCount.java",
        "KeyCodes.java",
        "TodoEntry.java",
        "TodoItem.java",
        "TodoList.java",
        "ViewsFragment.java",
        "package-info.java",
    ],
    visibility = ["//:__pkg__"],
)

j2cl_library(
    name = "views",
    srcs = [":views_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@sting//third_party/java:nullaway_plugin",
        "@react4j//:css_processor",
        "@react4j//:processor",
        "@arez//:arez_processor_plugin",
        "@sting//:sting_processor_plugin",
    ],
    deps = [
        "//examples/third_party/java:jspecify",
        "//examples/third_party/java:sting",
        "//examples/todomvc/src/main/java/react4j/todomvc/browser",
        "//examples/todomvc/src/main/java/react4j/todomvc/views:assets",
        "//examples/todomvc/sting/src/main/java/react4j/todomvc/sting/model",
        "@arez//:core-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@jsinterop_base//:jsinterop-base-j2cl",
        "@react4j//:core",
        "@react4j//:css",
        "@react4j//:dom",
    ],
)
