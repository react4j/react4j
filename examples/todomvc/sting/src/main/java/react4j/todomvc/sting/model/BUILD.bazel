load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

j2cl_library(
    name = "model",
    srcs = [
        "BrowserLocation.java",
        "FilterMode.java",
        "ModelFragment.java",
        "Todo.java",
        "TodoRepository.java",
        "TodoService.java",
        "ViewService.java",
        "package-info.java",
    ],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@react4j//third_party:nullaway_plugin",
        "@react4j//third_party:arez_processor_plugin",
        "@react4j//third_party:sting_processor_plugin",
    ],
    deps = [
        "//examples/todomvc/src/main/java/react4j/todomvc/browser",
        "@react4j//:core",
        "@react4j//third_party:arez_core-j2cl",
        "@react4j//third_party:jsinterop_annotations-j2cl",
        "@react4j//third_party:jsinterop_base-j2cl",
        "@react4j//third_party:jspecify-j2cl",
        "@react4j//third_party:sting_core-j2cl",
    ],
)
