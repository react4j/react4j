load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//examples:checks.bzl", "JAVACOPTS")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "webspeechdemo_sources",
    srcs = [
        "Application.java",
        "Main.java",
        "SpeechData.java",
        "package-info.java",
    ],
    visibility = ["//:__pkg__"],
)

j2cl_library(
    name = "webspeechdemo",
    srcs = [":webspeechdemo_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    javacopts = JAVACOPTS,
    plugins = [
        "@sting//third_party/java:nullaway_plugin",
        "@react4j//:css_processor",
        "@react4j//:processor",
        "@arez//:arez_processor_plugin",
    ],
    deps = [
        "//examples/third_party/java:jspecify",
        "//examples/webspeechdemo/src/main/java/react4j/webspeechdemo/browser",
        "//examples/webspeechdemo/src/main/java/react4j/webspeechdemo/browser/speech",
        "@arez//:core-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@jsinterop_base//:jsinterop-base-j2cl",
        "@react4j//:core",
        "@react4j//:css",
        "@react4j//:dom",
    ],
)

exports_files(
    [
        "Main.entry.js",
    ],
    visibility = ["//:__subpackages__"],
)
