load("//third_party/java:rules.bzl", "j2cl_library", "java_library")

package(default_visibility = ["//:__subpackages__"])

exports_files(
    [
        "Reconciler.native.js",
        "Renderer.native.js",
    ],
    visibility = ["//tools/release:__pkg__"],
)

_RECONCILER_SOURCES = [
    "ClassComponent.java",
    "FiberDevTools.java",
    "NativeReactRoot.java",
    "ReactPortal.java",
    "ReactRoot.java",
    "Reconciler.java",
    "ReconcilerHost.java",
    "ReconcilerScheduler.java",
    "UserTiming.java",
    "package-info.java",
]

java_library(
    name = "dom",
    srcs = _RECONCILER_SOURCES + [
        "BatchingTaskInterceptor.java",
        "BrowserScheduler.java",
        "DomEvents.java",
        "DomHost.java",
        "DomNesting.java",
        "DomReconcilerHost.java",
        "ReactDOM.java",
        "Renderer.java",
        "//dom/src/main/java/react4j/dom/events:sources",
        "//dom/src/main/java/react4j/dom/proptypes/cssPropertyTypes:sources",
        "//dom/src/main/java/react4j/dom/proptypes/html:sources",
        "//dom/src/main/java/react4j/dom/proptypes/html/attributeTypes:sources",
        "//tools/generation:dom_sources",
    ],
    deps = [
        "//core",
        "//third_party:arez_core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:org_jetbrains_annotations",
    ],
)

j2cl_library(
    name = "reconciler",
    srcs = _RECONCILER_SOURCES + ["Reconciler.native.js"],
    deps = [
        "//:core",
        "//third_party:jsinterop_annotations-j2cl",
        "//third_party:jsinterop_base-j2cl",
    ],
)
