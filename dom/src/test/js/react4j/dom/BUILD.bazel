load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//tools/browser:rules.bzl", "browser_test")

package(default_visibility = ["//:__pkg__"])

browser_test(
    name = "browser_tests",
    srcs = ["browser_test.js"],
    entry_point = "react4j.dom.BrowserTest",
    deps = [
        "//dom/src/test/java/react4j/dom:forms_scenarios",
        "//dom/src/test/java/react4j/dom:runtime_coverage",
        "//third_party:closure_testcase",
    ],
)

browser_test(
    name = "component_lifecycle_test",
    srcs = ["component_lifecycle_test.js"],
    entry_point = "react4j.dom.ComponentLifecycleTest",
    deps = ["//dom/src/test/java/react4j/dom:component_lifecycle_scenarios"],
)

browser_test(
    name = "update_scheduling_test",
    srcs = ["update_scheduling_test.js"],
    entry_point = "react4j.dom.UpdateSchedulingTest",
    deps = ["//dom/src/test/java/react4j/dom:update_scheduling_scenarios"],
)

browser_test(
    name = "devtools_test",
    srcs = ["devtools_test.js"],
    entry_point = "react4j.dom.DevToolsTest",
    deps = ["//dom/src/test/java/react4j/dom:runtime_coverage"],
)

browser_test(
    name = "emitter_test",
    srcs = ["emitter_test.js"],
    entry_point = "react4j.dom.EmitterTest",
    deps = [
        "//dom/src/test/java/react4j/dom:emitter_registration",
        "//dom/src/test/java/react4j/dom:runtime_coverage",
    ],
)

browser_test(
    name = "error_boundary_test",
    srcs = ["error_boundary_test.js"],
    entry_point = "react4j.dom.ErrorBoundaryTest",
    deps = ["//dom/src/test/java/react4j/dom:error_boundary_test"],
)

browser_test(
    name = "fiber_test",
    srcs = ["fiber_test.js"],
    entry_point = "react4j.dom.FiberTest",
    deps = ["//dom/src/test/java/react4j/dom:runtime_coverage"],
)

browser_test(
    name = "forms_test",
    srcs = ["forms_test.js"],
    entry_point = "react4j.dom.FormsTest",
    deps = ["//dom/src/test/java/react4j/dom:forms_scenarios"],
)

browser_test(
    name = "host_test",
    srcs = ["host_test.js"],
    entry_point = "react4j.dom.HostTest",
    deps = ["//dom/src/test/java/react4j/dom:host_scenarios"],
)

closure_js_library(
    name = "properties_test",
    testonly = True,
    srcs = ["properties_test.js"],
    visibility = ["//tools/verification/src/test/js/react4j/verification:__pkg__"],
    deps = ["//dom/src/test/java/react4j/dom:runtime_coverage"],
)

closure_js_library(
    name = "events_test",
    testonly = True,
    srcs = ["events_test.js"],
    visibility = ["//tools/verification/src/test/js/react4j/verification:__pkg__"],
    deps = ["//dom/src/test/java/react4j/dom:runtime_coverage"],
)

closure_js_library(
    name = "runtime_test",
    testonly = True,
    srcs = ["runtime_test.js"],
    visibility = ["//tools/verification/src/test/js/react4j/verification:__pkg__"],
    deps = [
        "//dom/src/test/java/react4j/dom:component_lifecycle_scenarios",
        "//dom/src/test/java/react4j/dom:emitter_registration",
        "//dom/src/test/java/react4j/dom:runtime_coverage",
        "//dom/src/test/java/react4j/dom:update_scheduling_scenarios",
    ],
)
