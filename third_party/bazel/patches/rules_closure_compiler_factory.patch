@@ -0,0 +1,12 @@
+package com.google.javascript.jscomp;
+
+import java.io.IOException;
+import java.nio.file.Path;
+
+/** Creates a compiler configured by an opaque, declared build input. */
+public interface CompilerFactory {
+  Compiler create(Path configuration, Path report) throws IOException;
+
+  /** Completes extension output after the successful compilation has written JavaScript. */
+  default void finish(Compiler compiler, Path javascript) throws IOException {}
+}
