]

java_import(
    name = "_core_java",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    visibility = ["//:__subpackages__"],
    exports = _RUNTIME,
)

java_import(
    name = "_dom_java",
    jars = ["//tools/release:dom_jar"],
    srcjar = "//tools/release:dom_sources",
    visibility = ["//:__subpackages__"],
    exports = [":_core_java"] + _RUNTIME,
)

java_import(
    name = "_processor_java",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
    visibility = ["//visibility:private"],
)

java_plugin(
    name = "processor",
    generates_api = True,
    processor_class = "react4j.processor.React4jProcessor",
    visibility = ["//visibility:public"],
    deps = [":_processor_java"],
)

_BROWSER_RUNTIME = [
    "//third_party:braincheck_core-j2cl",
    "//third_party:javaemul_internal_annotations-j2cl",
    "//third_party:jsinterop_annotations-j2cl",
    "//third_party:jsinterop_base-j2cl",
    "//third_party:jspecify-j2cl",
    "//third_party:org_jetbrains_annotations-j2cl",
    "//third_party:zemeckis_core-j2cl",
    "//third_party:arez_core-j2cl",
]

# Public aliases keep J2CL's generated Wasm/Kotlin companion targets private.
j2cl_library(
    name = "_core_j2cl",
    srcs = ["//tools/release:core_j2cl_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//visibility:private"],
    exports = _BROWSER_RUNTIME,
    deps = _BROWSER_RUNTIME,
)

j2cl_library(
    name = "_dom_j2cl",
    srcs = ["//tools/release:dom_j2cl_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//visibility:private"],
    exports = [":_core_j2cl"],
    deps = [
        ":_core_j2cl",
        "//third_party:arez_core-j2cl",
        "//third_party:braincheck_core-j2cl",
        "//third_party:jsinterop_annotations-j2cl",
        "//third_party:jsinterop_base-j2cl",
        "//third_party:jspecify-j2cl",
        "//third_party:org_jetbrains_annotations-j2cl",
        "//third_party:zemeckis_core-j2cl",
    ],
)

alias(
    name = "core",
    actual = ":_core_j2cl",
    visibility = ["//visibility:public"],
)

alias(
    name = "dom",
    actual = ":_dom_j2cl",
    visibility = ["//visibility:public"],
)

alias(
    name = "css",
    actual = "//css/core:core-j2cl",
    visibility = ["//visibility:public"],
)

alias(
    name = "css_processor",
    actual = "//css/processor:plugin",
