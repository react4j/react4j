load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_java//java:defs.bzl", "java_import", "java_plugin")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        "//css/core/src/main/java/react4j/css",
        "//css/internal/src/main/java/react4j/css/internal",
        "//css/internal/src/test/java/react4j/css/internal:tests",
        "//css/bundler/src/main/java/react4j/css/bundler",
        "//css/bundler/src/test/java/react4j/css/bundler:tests",
        "//css/processor/src/test/fixtures:inputs",
        "//css/processor/src/main/java/react4j/css/processor",
        "//css/processor/src/test/java/react4j/css/processor:compiler_tests",
        "//css/processor/src/test/java/react4j/css/processor:names_tests",
        "//css/processor/src/test/java/react4j/css/processor:text_block_tests",
        "//css/integration-tests/src/test/java/react4j/css/integration:integration_tests",
        "//css/integration-tests/src/test/java/react4j/css/integration:fixture_dependency_java",
        "//css/integration-tests/src/test/java/react4j/css/integration:fixture_bindings_java",
        "//css/integration-tests/src/test/java/react4j/css/integration:peer_bindings_java",
        "//css/processor/src/test/java/react4j/css/processor:processor_tests",
        "//css/examples/save-button/src/main/java/react4j/css/example:bindings_java",
        "//css/examples/save-button/src/main/java/react4j/css/example:browser_java",
        "//core",
        "//core:tests",
        "//dom",
        "//dom:tests",
        "//processor",
        "//processor/src/test/java/react4j/processor:test_classes",
        "//tools/testing/src/main/java/react4j/testing:golden_updater",
        "//tools/testing/src/main/java/react4j/testing:strict_generated_code",
        "//tools/browser:preview",
        "//tools/browser:assets",
        "//tools/consumer:config",
        "//tools/verification:coverage_check",
        "//tools/verification/src/test/java/react4j/verification:coverage_tests",
        "//doc-examples:java",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/audio:audio_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/core:core_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser/promise:promise_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/browser:browser_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/cache:cache_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/ioc:ioc_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/model:model_java",
        "//examples/drumloop/src/main/java/react4j/drumloop/views:views_java",
        "//examples/drumloop/src/main/java/react4j/drumloop:drumloop_java",
        "//examples/drumloop/src/test/java/react4j/drumloop/cache:cache_tests_java",
        "//examples/heart-rate-monitor/src/main/java/react4j/hrm/browser/bluetooth:bluetooth_java",
        "//examples/heart-rate-monitor/src/main/java/react4j/hrm/browser/core:core_java",
        "//examples/heart-rate-monitor/src/main/java/react4j/hrm/browser/promise:promise_java",
        "//examples/heart-rate-monitor/src/main/java/react4j/hrm/browser:browser_java",
        "//examples/heart-rate-monitor/src/main/java/react4j/hrm:hrm_java",
        "//examples/todomvc/arez/src/main/java/react4j/todomvc/arez/model:model_java",
        "//examples/todomvc/arez/src/main/java/react4j/todomvc/arez/views:views_java",
        "//examples/todomvc/arez/src/main/java/react4j/todomvc/arez:todomvc_java",
        "//examples/todomvc/raw/src/main/java/react4j/todomvc/raw/model:model_java",
        "//examples/todomvc/raw/src/main/java/react4j/todomvc/raw/views:views_java",
        "//examples/todomvc/raw/src/main/java/react4j/todomvc/raw:todomvc_java",
        "//examples/todomvc/src/main/java/react4j/todomvc/browser:browser_java",
        "//examples/todomvc/sting/src/main/java/react4j/todomvc/sting/ioc:ioc_java",
        "//examples/todomvc/sting/src/main/java/react4j/todomvc/sting/model:model_java",
        "//examples/todomvc/sting/src/main/java/react4j/todomvc/sting/views:views_java",
