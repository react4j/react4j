        "//examples/webspeechdemo/src/main/java/react4j/webspeechdemo/browser:browser_java",
        "//examples/webspeechdemo/src/main/java/react4j/webspeechdemo:webspeechdemo_java",
        "//tools/site/src/main/java/react4j/site:site",
        "//tools/site:tool",
        "//tools/site/src/test/java/react4j/site:all_tests",
        "//tools/release:artifact_check",
        "//tools/release/consumer/src/main/java/isolated:packaged_consumer",
        "//tools/release:jar_builder",
        "//tools/release/src/main/java/react4j/release:bundle_classes",
        "//tools/release/src/test/java/react4j/release:bundle_tests",
        "//tools/release:javadoc_jar_builder",
        "//tools/generation:dom_generator",
        "//tools/generation:react_asset_patcher",
    ],
)

_RUNTIME = [
    "//third_party/java:arez_core",
    "//third_party/java:base",
    "//third_party/java:braincheck_core",
    "//third_party/java:javaemul_internal_annotations",
    "//third_party/java:jsinterop_annotations",
    "//third_party/java:jspecify",
    "//third_party/java:org_jetbrains_annotations",
    "//third_party/java:zemeckis_core",
]

java_import(
    name = "core",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    exports = _RUNTIME,
)

java_import(
    name = "dom",
    jars = ["//tools/release:dom_jar"],
    srcjar = "//tools/release:dom_sources",
    exports = [":core"] + _RUNTIME,
)

java_import(
    name = "processor",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
)

java_plugin(
    name = "react4j_processor_plugin",
    generates_api = True,
    processor_class = "react4j.processor.React4jProcessor",
    deps = [":processor"],
)

j2cl_library(
    name = "core-j2cl",
    srcs = ["//tools/release:core_j2cl_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:javaemul_internal_annotations-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
        "//third_party/java:zemeckis_core-j2cl",
        "@arez//:core-j2cl",
    ],
)

j2cl_library(
    name = "dom-j2cl",
    srcs = ["//tools/release:dom_j2cl_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        ":core-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
        "//third_party/java:zemeckis_core-j2cl",
        "@arez//:core-j2cl",
    ],
)

test_suite(
    name = "browser_tests",
    tests = [
        "//css/examples/save-button/src/test/js/react4j/css/example:browser_tests",
        "//doc-examples/src/test/js/react4j/examples:browser_tests",
        "//examples/drumloop/src/test/js/react4j/drumloop:browser_tests",
        "//examples/heart-rate-monitor/src/test/js/react4j/hrm:browser_tests",
        "//examples/todomvc/src/test/js/react4j/todomvc:browser_tests",
        "//examples/webspeechdemo/src/test/js/react4j/webspeechdemo:browser_tests",
    ],
)

test_suite(
    name = "jvm_tests",
    tests = [
        "//core:tests",
        # Keep CSS coverage independent of packaged processor/golden tests.
        "//css/processor/src/test/java/react4j/css/processor:unit_tests",
        "//css/internal/src/test/java/react4j/css/internal:tests",
        "//css/bundler/src/test/java/react4j/css/bundler:tests",
        "//dom:tests",
        "//processor:all_tests",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":browser_tests",
        ":jvm_tests",
        "//css/integration-tests/src/test/java/react4j/css/integration:integration_tests",
        "//css/processor/src/test/java/react4j/css/processor:processor_tests",
        "//third_party/java:verify_config_sha256",
        "//tools/release:tests",
        "//tools/site:tests",
        "//tools/verification/src/test/java/react4j/verification:coverage_tests",
    ],
)
