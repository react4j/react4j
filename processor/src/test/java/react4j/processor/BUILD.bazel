load("//third_party/java:rules.bzl", "FORMATTER_JVM_FLAGS", "java_library", "java_testng")

package(default_visibility = ["//:__subpackages__"])

java_library(
    name = "test_classes",
    testonly = True,
    srcs = [
        "NullabilityTest.java",
        "React4jProcessorTest.java",
    ],
    deps = [
        "//processor",
        "//third_party:arez_processor_runtime",
        "//third_party:proton_core",
        "//third_party:proton_qa",
        "//third_party:sting_processor_runtime",
        "//third_party/java:testng",
        "//tools/testing/src/main/java/react4j/testing:strict_generated_code",
    ],
)

_FLAGS = FORMATTER_JVM_FLAGS + [
    "-Dreact4j.fixture_dir=processor/src/test/fixtures",
    "-Xmx1024m",
    "--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED",
    "--add-exports=jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED",
    "--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
    "--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED",
]

_RUNTIME = [
    ":test_classes",
    "//core",
    "//processor",
    "//third_party:arez_core",
    "//third_party:arez_processor_runtime",
    "//third_party:sting_core",
    "//third_party:sting_processor_runtime",
    "//third_party/java:base",
    "//third_party/java:braincheck_core",
    "//third_party/java:grim_annotations",
    "//third_party/java:org_jetbrains_annotations",
    "//third_party/java:jsinterop_annotations",
    "//third_party/java:zemeckis_core",
]

java_testng(
    name = "regressions",
    size = "medium",
    srcs = [],
    data = [
        "//processor/src/test/fixtures",
        "//third_party/java:strict_checker_options",
    ],
    jvm_flags = _FLAGS,
    test_class = "react4j.processor.React4jProcessorTest",
    test_methods = [
        "react4j.processor.React4jProcessorTest.processSuccessfulRawTypeCompileWithoutSting",
        "react4j.processor.React4jProcessorTest.formatGeneratedSourceFailsClearlyWithoutJdkExports",
    ],
    deps = _RUNTIME,
)

