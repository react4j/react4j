java_testng(
    name = "diagnostics",
    size = "large",
    srcs = [],
    data = ["//processor/src/test/fixtures"],
    jvm_flags = _FLAGS,
    test_class = "react4j.processor.React4jProcessorTest",
    test_methods = [
        "react4j.processor.React4jProcessorTest.processCompileWithWarnings",
        "react4j.processor.React4jProcessorTest.processFailedCompile",
        "react4j.processor.React4jProcessorTest.processFailedCompileInheritedPackageAccessFieldInDifferentPackage",
        "react4j.processor.React4jProcessorTest.processFailedCompileInheritedPackageAccessInDifferentPackage",
    ],
    deps = _RUNTIME,
