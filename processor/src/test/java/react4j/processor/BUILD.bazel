        "react4j.processor.React4jProcessorTest.nestedCompleteComponent",
        "react4j.processor.React4jProcessorTest.renderFromParent",
        "react4j.processor.React4jProcessorTest.trackingInheritedAutoObserveMethodView",
        "react4j.processor.React4jProcessorTest.validProtectedAccessOnError",
        "react4j.processor.React4jProcessorTest.validPublicAccessViaInterfaceOnError",
        "react4j.processor.React4jProcessorTest.validProtectedAccessOnPropChange",
        "react4j.processor.React4jProcessorTest.validPublicAccessViaInterfaceOnPropChange",
        "react4j.processor.React4jProcessorTest.validProtectedAccessPostMount",
        "react4j.processor.React4jProcessorTest.validPublicAccessViaInterfacePostMount",
        "react4j.processor.React4jProcessorTest.validProtectedAccessPostMountOrUpdate",
        "react4j.processor.React4jProcessorTest.validPublicAccessViaInterfacePostMountOrUpdate",
        "react4j.processor.React4jProcessorTest.validProtectedAccessPostRender",
        "react4j.processor.React4jProcessorTest.validPublicAccessViaInterfacePostRender",
        "react4j.processor.React4jProcessorTest.validProtectedAccessPostUpdate",
