load("//third_party/java:rules.bzl", "FORMATTER_JVM_FLAGS", "java_library", "java_testng")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "test_classes",
    testonly = True,
    srcs = ["React4jProcessorTest.java"],
    deps = [
        "//processor",
        "//third_party/java:arez_processor_runtime",
        "//third_party/java:proton_qa",
        "//third_party/java:sting_processor_runtime",
        "//third_party/java:testng",
    ],
)

_FLAGS = FORMATTER_JVM_FLAGS + [
    "-Dreact4j.fixture_dir=processor/src/test/fixtures",
    "-Xmx1024m",
]

_RUNTIME = [
    ":test_classes",
    "//core",
    "//processor",
    "//third_party/java:arez_core",
    "//third_party/java:arez_processor_runtime",
    "//third_party/java:sting_core",
    "//third_party/java:sting_processor_runtime",
    "//third_party/java:base",
    "//third_party/java:braincheck_core",
    "//third_party/java:grim_annotations",
    "//third_party/java:org_jetbrains_annotations",
    "//third_party/java:jsinterop_annotations",
    "//third_party/java:zemeckis_core",
]

java_testng(
    name = "smoke_goldens",
    size = "medium",
    srcs = [],
    data = ["//processor/src/test/fixtures"],
    jvm_flags = _FLAGS,
    test_class = "react4j.processor.React4jProcessorTest",
    test_methods = ["react4j.processor.React4jProcessorTest.goldenSmoke"],
    deps = _RUNTIME,
)

java_testng(
    name = "smoke_diagnostics",
    size = "medium",
    srcs = [],
    data = ["//processor/src/test/fixtures"],
    jvm_flags = _FLAGS,
    test_class = "react4j.processor.React4jProcessorTest",
    test_methods = ["react4j.processor.React4jProcessorTest.diagnosticSmoke"],
    deps = _RUNTIME,
)

java_testng(
    name = "regressions",
    size = "medium",
    srcs = [],
    data = ["//processor/src/test/fixtures"],
    jvm_flags = _FLAGS,
    test_class = "react4j.processor.React4jProcessorTest",
    test_methods = [
        "react4j.processor.React4jProcessorTest.processSuccessfulRawTypeCompileWithoutSting",
        "react4j.processor.React4jProcessorTest.formatGeneratedSourceFailsClearlyWithoutJdkExports",
    ],
    deps = _RUNTIME,
)

java_testng(
    name = "generated_goldens",
    size = "large",
