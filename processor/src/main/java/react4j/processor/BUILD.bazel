    name = "processor",
    srcs = [
        "BuilderDescriptor.java",
        "BuilderGenerator.java",
        "Constants.java",
        "FactoryGenerator.java",
        "ImmutableInputKeyStrategy.java",
        "InputComparator.java",
        "InputDescriptor.java",
        "Nullability.java",
        "ObserveMode.java",
        "OnInputChangeDescriptor.java",
        "PreludeChecksDescriptor.java",
        "PublishDescriptor.java",
        "React4jProcessor.java",
        "RenderHookDescriptor.java",
        "ScheduleRenderDescriptor.java",
        "Step.java",
        "StepMethod.java",
        "StepMethodType.java",
        "ViewDescriptor.java",
        "ViewGenerator.java",
        "ViewType.java",
        "package-info.java",
    ],
    resource_strip_prefix = "processor/src/main/resources",
    resources = ["//processor/src/main/resources/META-INF/services:javax.annotation.processing.Processor"],
    deps = [
        "//third_party/java:javapoet",
        "//third_party/java:proton_core",
